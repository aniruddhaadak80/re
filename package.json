{
  "name": "revlens-monorepo",
  "private": true,
  "version": "0.1.1",
  "description": "RevLens: the zero-install reverse engineering lens for agents and humans",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "npm run build -w @revlens/core && npm run build -w revlens && npm run build -w @revlens/mcp",
    "build:web": "npm run build -w @revlens/web",
    "typecheck": "tsc -b packages/core packages/cli packages/mcp",
    "test": "node --test --import tsx packages/core/test/*.test.ts",
    "cli": "node --import tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
