{
  "name": "@revlens/web",
  "version": "0.1.1",
  "private": true,
  "description": "RevLens web app: look inside any binary, bundle or package in your browser.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "predev": "node scripts/prebuild.mjs",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview --base /re/ --port 4173 --strictPort",
    "test": "playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "framer-motion": "^14.11.1",
    "lucide-react": "^1.71.0",
    "mermaid": "^12.3.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^7.18.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "postcss": "^8.5.32",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
