{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@revlens/core": ["../../packages/core/src/index.ts"],
      "@revlens/core/internal/*": ["../../packages/core/src/*"],
      "@revlens/engine": ["../../packages/engine/src/index.ts"],
      "@revlens/managed": ["../../packages/managed/src/index.ts"],
      "@revlens/webrt": ["../../packages/webrt/src/index.ts"],
      "@revlens/mobile": ["../../packages/mobile/src/index.ts"],
      "@revlens/disasm": ["../../packages/disasm/src/index.ts"],
      "@revlens/extras": ["../../packages/extras/src/index.ts"],
      "@revlens/desktop": ["../../packages/desktop/src/index.ts"]
    }
  },
  "include": ["src", "e2e", "vite.config.ts", "playwright.config.ts"]
}
