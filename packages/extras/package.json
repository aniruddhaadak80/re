{
  "name": "@revlens/extras",
  "version": "1.0.0",
  "description": "RevLens extras in pure TypeScript: C++/Rust/MSVC/Swift demangling, raw byte tools, Go and Rust toolchain facts, deep PE (resources, version info, manifest, rich header, Authenticode, installers), ELF notes, unwind ranges and kernel modules, Mach-O code signatures, firmware containers, GPU code objects, V8 and Hermes headers, model files, Windows shortcuts, Apple crash reports, an evidence and claims ledger, and an agent eval harness.",
  "license": "MIT AND Apache-2.0 WITH Swift-exception",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "LICENSE-SWIFT.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "fetch-fixtures": "node scripts/fetch-fixtures.mjs"
  },
  "dependencies": {
    "@revlens/core": "*"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "keywords": [
    "reverse-engineering",
    "demangle",
    "swift",
    "go",
    "gopclntab",
    "pe",
    "authenticode",
    "firmware",
    "uimage",
    "squashfs",
    "uefi",
    "spirv",
    "ptx",
    "v8",
    "hermes",
    "gguf",
    "lnk",
    "evidence",
    "eval",
    "ledger",
    "lnk",
    "ips"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/re.git",
    "directory": "packages/extras"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0"
  }
}
