{
  "name": "@revlens/webrt",
  "version": "1.0.0",
  "description": "RevLens web runtime reverse engineering: JavaScript deobfuscation and bundle unpacking, source map recovery, Electron ASAR and security audit, browser capture, PCAP, SQLite and HAR analysis.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "dependencies": {
    "@babel/generator": "^7.29.1",
    "@babel/parser": "^7.29.2",
    "@babel/types": "^7.29.0"
  },
  "peerDependencies": {
    "@revlens/core": "*",
    "playwright": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "@revlens/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electron/asar": "^4.3.1",
    "@electron/fuses": "^2.1.3",
    "@types/babel__generator": "^7.27.0",
    "javascript-obfuscator": "^5.10.0",
    "webpack": "^5.112.2"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "keywords": [
    "reverse-engineering",
    "javascript",
    "deobfuscation",
    "webpack",
    "sourcemap",
    "electron",
    "asar",
    "pcap",
    "ja3",
    "sqlite",
    "har"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/re.git",
    "directory": "packages/webrt"
  }
}
