{
  "name": "@revlens/managed",
  "version": "1.0.0",
  "description": "RevLens managed and bytecode runtimes: .NET metadata and CIL, Python pyc and PyInstaller, Lua, Erlang BEAM and EVM bytecode. Pure TypeScript.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --import tsx test/*.test.ts",
    "fetch-fixtures": "node scripts/fetch-fixtures.mjs"
  },
  "dependencies": {
    "@revlens/core": "1.0.0",
    "fflate": "^0.8.3"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "keywords": [
    "reverse-engineering",
    "dotnet",
    "cil",
    "ecma-335",
    "pyc",
    "pyinstaller",
    "lua",
    "beam",
    "evm",
    "solidity"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/re.git",
    "directory": "packages/managed"
  }
}
