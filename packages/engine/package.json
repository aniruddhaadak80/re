{
  "name": "@revlens/engine",
  "version": "1.0.0",
  "description": "RevLens engine: runs the core analyzers plus every RevLens package (managed runtimes, web runtime, mobile, disassembler) on one combined report, and collects all agent tools and CLI commands.",
  "license": "MIT",
  "author": "Aniruddha Adak",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@revlens/bridges": "1.0.0",
    "@revlens/core": "1.0.0",
    "@revlens/disasm": "1.0.0",
    "@revlens/managed": "1.0.0",
    "@revlens/mobile": "1.0.0",
    "@revlens/webrt": "1.0.0"
  },
  "engines": {
    "node": ">=20.10.0"
  },
  "keywords": [
    "reverse-engineering",
    "revlens",
    "engine"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aniruddhaadak80/re.git",
    "directory": "packages/engine"
  }
}
